# Copy to `.env` and fill in. All frontend env vars MUST be prefixed with VITE_.

# Supabase project (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
# The ANON / public key (safe for the browser). NOT the service_role key.
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# Backend API base URL
#   local:  http://localhost:8000
#   prod:   https://web-production-a2bab.up.railway.app
VITE_API_BASE_URL=http://localhost:8000
